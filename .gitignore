*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local module build artifacts
modules/**/build/

# design preview render output (regenerate: node design-previews/gen*.js)
design-previews/out/
design-previews/out-ledger/
design-previews/out-quiet/
design-previews/out-quiet-dark/
design-previews/out-quiet-v2/
design-previews/out-quiet-surfaces/
