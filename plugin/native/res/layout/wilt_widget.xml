<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget face — "Quiet" look. RemoteViews only supports basic
  layout/widget classes, so this stays nested LinearLayouts + TextViews. The
  amber "time wasted" readout and budget line mirror the in-app dashboard; the
  service recolours the time + limit red once the daily limit is blown. The cat
  on the right rots (fresh -> skull) with how close you are; see CatDecay.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wilt_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/wilt_widget_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WILT"
            android:textColor="#9A9A92"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0m"
                android:textColor="#E0913C"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="wasted today"
                android:textColor="#9A9A92"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="60 min left of your limit"
            android:textColor="#E0913C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_reels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 reels"
                android:textColor="#9A9A92"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_shorts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="0 shorts"
                android:textColor="#9A9A92"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_cat"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginStart="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/wilt_pill_head_1"
        android:contentDescription="Cat, decaying with time spent" />
</LinearLayout>
